# ─────────────────────────────────────────────────────────────
# Supabase
# Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key used by the reminder cron job to read across tenants.
# NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────
# Email (Resend) — used by automated vacancy reminders
# https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
# The "from" address must be on a domain you've verified in Resend.
REMINDER_FROM_EMAIL="Property Management <alerts@yourdomain.com>"

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that protects the /api/cron/reminders endpoint.
# Vercel Cron sends this as a Bearer token (configure in Vercel project).
CRON_SECRET=generate-a-long-random-string

# Platform super-admins (you, the operator). Comma-separated emails. These
# accounts get a read-only, cross-tenant /admin area that can view any
# organization's dashboard. Leave empty to disable admin access entirely.
PLATFORM_ADMIN_EMAILS=justin.sobojinski@gmail.com

# ── Online rent collection (Stripe Connect) ────────────────────────────────
# Platform secret key (Stripe Dashboard → Developers → API keys). Use a
# sk_test_… key until you're ready for real money. Without it, online
# payments stay hidden and everything else works.
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the *Connect* webhook endpoint pointing at
# /api/stripe/webhook (Developers → Webhooks → "Events on connected accounts").
STRIPE_WEBHOOK_SECRET=whsec_...
